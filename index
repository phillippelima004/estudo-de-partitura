        function checkFit(newDuration) {
            let currentMeasureBeats = 0;
            let maxBeats = getMaxBeats();
            
            for (let n of notesArray) {
                if (['repeat-start', 'repeat-end', 'volta-1', 'volta-2'].includes(n.type)) continue;
                let b = durationBeats[n.duration] * (n.dot ? 1.5 : 1);
                currentMeasureBeats += b;
                if (currentMeasureBeats >= maxBeats - 0.001) {
                    currentMeasureBeats = 0;
                }
            }
            
            let addedB = durationBeats[newDuration] * (currentDot ? 1.5 : 1);
            if (currentMeasureBeats > 0 && (currentMeasureBeats + addedB) > maxBeats + 0.001) {
                showMessage(`Nota excederá a capacidade do compasso! Restam ${(maxBeats - currentMeasureBeats).toFixed(2)} tempos.`);
                return false;
            }
            return true;
        }

