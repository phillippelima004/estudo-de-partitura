        function renderStaff() {
            const container = document.getElementById("vf-container");
            container.innerHTML = "";
            
            const timeSig = document.getElementById("time-select").value;
            const measuresPerLine = parseInt(document.getElementById("measures-select").value);
            const tempoText = document.getElementById("tempo-select").value;
            const maxBeats = getMaxBeats();
            
            const availableWidth = container.clientWidth > 100 ? container.clientWidth - 40 : 850;
            const baseMeasureWidth = Math.max(160, Math.floor(availableWidth / measuresPerLine));

            let measures = [];
            let currentMeasure = { notes: [], repeatStart: false, repeatEnd: false, volta: null };
            let currentBeats = 0;

            for (let n of notesArray) {
                if (n.type === 'repeat-start') {
                    currentMeasure.repeatStart = true;
                    continue;
                }
                if (n.type === 'repeat-end') {
                    currentMeasure.repeatEnd = true;
                    continue;
                }
                if (n.type === 'volta-1') {
                    currentMeasure.volta = 1;
                    continue;
                }
                if (n.type === 'volta-2') {
                    currentMeasure.volta = 2;
                    continue;
                }

                currentMeasure.notes.push(n);
                currentBeats += durationBeats[n.duration] * (n.dot ? 1.5 : 1);
                
                if (currentBeats >= maxBeats - 0.001) {
                    measures.push(currentMeasure);
                    currentMeasure = { notes: [], repeatStart: false, repeatEnd: false, volta: null };
                    currentBeats = 0;
                }
            }
            if (currentMeasure.notes.length > 0 || currentMeasure.repeatStart || currentMeasure.repeatEnd || currentMeasure.volta) {
                measures.push(currentMeasure);
            }
            if (measures.length === 0) {
                measures.push({ notes: [], repeatStart: false, repeatEnd: false, volta: null });
            }

            let lines = [];
            for (let i = 0; i < measures.length; i += measuresPerLine) {
                lines.push(measures.slice(i, i + measuresPerLine));
            }

            lines.forEach((lineMeasures, lineIndex) => {
                const lineDiv = document.createElement("div");
                lineDiv.style.marginBottom = "10px";
                lineDiv.style.display = "flex";
                lineDiv.style.justifyContent = "center";
                container.appendChild(lineDiv);

                let totalLineWidth = lineMeasures.reduce((acc, _, idx) => acc + baseMeasureWidth + (idx === 0 ? 80 : 0), 20);

                const renderer = new VF.Renderer(lineDiv, VF.Renderer.Backends.SVG);
                renderer.resize(totalLineWidth, 170);
                const context = renderer.getContext();

                let xPos = 10;

                for (let i = 0; i < lineMeasures.length; i++) {
                    const measureData = lineMeasures[i];
                    const isFirstMeasureOfLine = (i === 0);
                    let mWidth = baseMeasureWidth;
                    
                    if (isFirstMeasureOfLine) mWidth += 80; 

                    const stave = new VF.Stave(xPos, 50, mWidth);
                    
                    if (isFirstMeasureOfLine) {
                        stave.addClef(currentClef).addTimeSignature(timeSig);
                        if (lineIndex === 0) {
                            stave.setTempo({ 
                                name: tempoText.split('(')[0].trim(), 
                                duration: 'q', 
                                bpm: parseInt(tempoText.match(/\d+/)[0]) 
                            }, -30);
                        }
                    }
                    if (measureData.repeatStart) {
                        stave.setBegBarType(VF.Barline.type.REPEAT_BEGIN);
                    }
                    if (measureData.repeatEnd) {
                        stave.setEndBarType(VF.Barline.type.REPEAT_END);
                    } else if (lineIndex === lines.length - 1 && i === lineMeasures.length - 1) {
                        stave.setEndBarType(VF.Barline.type.END);
                    }

                    if (measureData.volta) {
                        stave.setVoltaType(
                            measureData.volta === 1 ? VF.Volta.type.BEGIN : VF.Volta.type.BEGIN_END,
                            `${measureData.volta}.`,
                            -5
                        );
                    }

                    stave.setContext(context).draw();

                    const measureNotes = measureData.notes;
                    if (measureNotes && measureNotes.length > 0) {
                        let tiePairs = [];
                        const vfNotes = measureNotes.map((n, idx) => {
                            let vfDuration = n.duration;
                            if (n.dot) vfDuration += "d";

                            if (n.type === 'rest') {
                                const note = new VF.StaveNote({ keys: ["b/4"], duration: vfDuration + "r", clef: currentClef });
                                if (n.dot) note.addDot(0);
                                n.vfNoteObj = note;
                                return note;
                            } else {
                                const keyStr = n.accidental && n.accidental !== 'n' 
                                    ? `${n.key}${n.accidental}/${n.octave}` 
                                    : `${n.key}/${n.octave}`;
                                const note = new VF.StaveNote({ keys: [keyStr], duration: vfDuration, clef: currentClef });
                                
                                if (n.accidental) {
                                    note.addAccidental(0, new VF.Accidental(n.accidental));
                                }
                                if (n.dot) {
                                    note.addDot(0);
                                }
                                if (n.staccato) {
                                    note.addModifier(0, new VF.Articulation('a.').setPosition(3));
                                }
                                if (n.bow) {
                                    const artCode = n.bow === 'talao' ? 'am' : 'a|';
                                    note.addModifier(0, new VF.Articulation(artCode).setPosition(3));
                                }
                                if (n.fingering) {
                                    note.addModifier(0, new VF.StringNumber(n.fingering).setPosition(3));
                                }
                                if (n.stringInd) {
                                    note.addModifier(0, new VF.Annotation(n.stringInd).setFont('sans-serif', 9, 'bold').setVerticalJustification(VF.Annotation.VerticalJustify.BOTTOM));
                                }
                                if (n.dynamic) {
                                    note.addModifier(0, new VF.Annotation(n.dynamic).setFont('serif', 12, 'italic bold').setVerticalJustification(VF.Annotation.VerticalJustify.BOTTOM));
                                }
                                
                                n.vfNoteObj = note;

                                if (n.tieNext && idx < measureNotes.length - 1 && measureNotes[idx+1].type === 'note') {
                                    tiePairs.push({ first: note, lastNoteIndex: idx + 1 });
                                }
                                return note;
                            }
                        });

                        const voice = new VF.Voice({ num_beats: maxBeats, beat_value: 4 });
                        voice.setMode(VF.Voice.Mode.SOFT);
                        voice.addTickables(vfNotes);

                        const formatter = new VF.Formatter().joinVoices([voice]).format([voice], mWidth - (isFirstMeasureOfLine ? 85 : 30));
                        
                        const beams = VF.Beam.generateBeams(vfNotes, {
                            groups: timeSig === '6/8' ? [new VF.Fraction(3, 8)] : [new VF.Fraction(1, 4)],
                            flat_beams: false
                        });

                        voice.draw(context, stave);
                        beams.forEach(b => b.setContext(context).draw());

                        tiePairs.forEach(tp => {
                            const lastNoteObj = measureNotes[tp.lastNoteIndex].vfNoteObj;
                            if (lastNoteObj) {
                                const tie = new VF.StaveTie({
                                    first_note: tp.first,
                                    last_note: lastNoteObj,
                                    first_indices: [0],
                                    last_indices: [0]
                                });
                                tie.setContext(context).draw();
                            }
                        });
                    }
                    xPos += mWidth;
                }
            });
        }

        // Inicialização
        updateStringButtons();
        renderStaff();
        window.addEventListener('resize', () => renderStaff());
    </script>
