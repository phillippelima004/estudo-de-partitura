        }

        // Importador de MusicXML
        document.getElementById('musicxmlInput').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(evt) {
                try {
                    const xmlText = evt.target.result;
                    const parser = new DOMParser();
                    const xmlDoc = parser.parseFromString(xmlText, "text/xml");

                    notesArray = [];
                    const measureNodes = xmlDoc.getElementsByTagName("measure");

                    if (measureNodes.length === 0) {
                        showMessage("Nenhum compasso encontrado no arquivo MusicXML.");
                        return;
                    }

                    for (let i = 0; i < measureNodes.length; i++) {
                        let noteNodes = measureNodes[i].getElementsByTagName("note");

                        for (let j = 0; j < noteNodes.length; j++) {
                            let noteEl = noteNodes[j];
                            let isRest = noteEl.getElementsByTagName("rest").length > 0;
                            let typeEl = noteEl.getElementsByTagName("type")[0];
                            
                            let durationMap = { "whole": "w", "half": "h", "quarter": "q", "eighth": "8", "16th": "16", "32nd": "32" };
                            let dur = typeEl && durationMap[typeEl.textContent] ? durationMap[typeEl.textContent] : "q";

                            if (isRest) {
                                notesArray.push({
                                    type: 'rest',
                                    duration: dur,
                                    dot: noteEl.getElementsByTagName("dot").length > 0
                                });
                            } else {
                                let pitchEl = noteEl.getElementsByTagName("pitch")[0];
                                if (pitchEl) {
                                    let step = pitchEl.getElementsByTagName("step")[0].textContent.toLowerCase();
                                    let octave = parseInt(pitchEl.getElementsByTagName("octave")[0].textContent, 10);
                                    let alterEl = pitchEl.getElementsByTagName("alter")[0];
                                    let acc = null;
                                    if (alterEl) {
                                        if (alterEl.textContent === "1") acc = "#";
                                        else if (alterEl.textContent === "-1") acc = "b";
                                    }

                                    notesArray.push({
                                        type: 'note',
                                        key: step,
                                        octave: octave,
                                        accidental: acc,
                                        duration: dur,
                                        dot: noteEl.getElementsByTagName("dot").length > 0,
                                        staccato: false,
                                        tieNext: false,
                                        fingering: null,
                                        stringInd: null,
                                        dynamic: null
                                    });
                                }
                            }
                        }
                    }

                    renderStaff();
                    showMessage("Partitura MusicXML importada com sucesso!");
                } catch (err) {
                    showMessage("Erro ao ler o arquivo MusicXML: " + err.message);
                }
            };
            reader.readAsText(file);
        });

