<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Caderno de Estudo Musical - Viola, Violino & Violoncelo</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- VexFlow 3.0.9 para renderização de partitura -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/vexflow/3.0.9/vexflow-min.js"></script>
  <!-- html2pdf.js para exportação de PDF -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  <!-- FontAwesome para ícones -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    body { 
      font-family: 'Inter', sans-serif; 
      background-color: #f3f4f6; 
    }
    .staff-container { 
      width: 100%; 
      overflow-x: auto; 
      text-align: center; 
    }
    .pdf-hide { 
      display: block; 
    }
    .pdf-mode .pdf-hide { 
      display: none !important; 
    }
    .pdf-mode { 
      background-color: white; 
      padding: 20px; 
    }
    
    .staff-container svg {
      max-width: 100%;
      height: auto;
      overflow: visible !important;
      margin: 0 auto;
    }

    /* Estilo para destaque da nota durante o playback */
    .vf-notehead.playing-note path {
      fill: #4f46e5 !important;
      stroke: #4f46e5 !important;
      filter: drop-shadow(0px 0px 4px #818cf8);
    }
    input[type="file"] {
      display: none;
    }
  </style>
</head>
<body class="min-h-screen text-gray-800 p-2 sm:p-6 flex flex-col items-center">

    <div id="app-container" class="w-full max-w-6xl bg-white rounded-2xl shadow-xl p-4 sm:p-6">
        
        <!-- Cabeçalho e Ações Principais -->
        <div class="flex flex-col sm:flex-row justify-between items-center mb-6 border-b pb-4 pdf-hide gap-3">
            <div>
                <h1 class="text-2xl font-extrabold text-indigo-700 tracking-tight" id="app-header-title">Estúdio de Música &amp; Partitura</h1>
                <p class="text-xs text-gray-500 font-medium" id="app-header-subtitle">Clave de Dó (Viola), Sol (Violino) &amp; Fá (Violoncelo) • Caderno de Estudos</p>
            </div>
            <div class="flex flex-wrap gap-2 w-full sm:w-auto items-center justify-end">
                <input type="text" id="music-title-input" placeholder="Título da Partitura / Exercício..." class="border border-gray-300 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 flex-1 sm:w-60">
                
                <!-- Importador de MusicXML -->
                <label for="musicxmlInput" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-1.5 px-3 rounded-lg transition-colors shadow-sm text-sm cursor-pointer flex items-center gap-1.5">
                    <i class="fa-solid fa-file-import"></i> Importar XML
                </label>
                <input type="file" id="musicxmlInput" accept=".xml,.musicxml">

                <button onclick="savePDF()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-1.5 px-3 rounded-lg transition-colors shadow-sm text-sm shrink-0 flex items-center gap-1.5">
                    <i class="fa-solid fa-file-pdf"></i> Salvar PDF
                </button>
            </div>
        </div>

        <!-- Título que aparece exclusivamente no PDF -->
        <h2 id="pdf-title" class="text-3xl font-bold text-center mb-6 hidden"></h2>

        <!-- Mensagens de Alerta / Validação -->
        <div id="message-box" class="hidden mb-4 p-3 bg-red-100 text-red-700 rounded-lg text-sm text-center font-medium shadow-sm"></div>

        <!-- Painel de Áudio, Metrônomo e Playback -->
        <div class="pdf-hide bg-indigo-900 text-white p-3.5 sm:p-4 rounded-xl mb-6 shadow-md">
            <div class="flex flex-wrap items-center justify-between gap-4">
                
                <!-- Playback Áudio -->
                <div class="flex items-center gap-2">
                    <span class="text-xs font-bold uppercase tracking-wider text-indigo-300 mr-1">Reprodução:</span>
                    <button id="play-btn" onclick="togglePlay()" class="bg-indigo-500 hover:bg-indigo-400 text-white px-3.5 py-1.5 rounded-lg font-bold text-xs sm:text-sm flex items-center gap-1.5 transition-all shadow-sm">
                        <span id="play-icon">▶</span> <span id="play-text">Ouvir Partitura</span>
                    </button>
                    <button onclick="stopPlayback()" class="bg-indigo-800 hover:bg-indigo-700 text-indigo-200 px-3 py-1.5 rounded-lg font-bold text-xs sm:text-sm transition-all">
                        ■ Parar
                    </button>
                </div>

                <!-- Metrônomo Integrado -->
                <div class="flex items-center gap-3 bg-indigo-950/60 px-3 py-1.5 rounded-lg border border-indigo-800">
                    <span class="text-xs font-bold uppercase tracking-wider text-indigo-300">Metrônomo:</span>
                    <button id="metro-btn" onclick="toggleMetronome()" class="bg-emerald-600 hover:bg-emerald-500 text-white px-2.5 py-1 rounded text-xs font-bold transition-all">
                        Ligar
                    </button>
                    <div class="flex items-center gap-2">
                        <input type="range" id="bpm-range" min="40" max="208" value="80" oninput="updateBPM(this.value)" class="w-20 sm:w-28 accent-emerald-400 cursor-pointer">
                        <span id="bpm-display" class="text-xs font-mono font-bold text-emerald-300 min-w-[55px]">80 BPM</span>
                    </div>
                    <div id="metro-pulse" class="w-3 h-3 rounded-full bg-indigo-800 border border-indigo-600 transition-colors"></div>
                </div>

                <!-- Andamento da Música -->
                <div class="flex items-center gap-2">
                    <label class="text-xs font-bold uppercase text-indigo-300">Andamento:</label>
                    <select id="tempo-select" onchange="renderStaff()" class="bg-indigo-800 text-white text-xs rounded border border-indigo-700 px-2 py-1 focus:outline-none">
                        <option value="Moderato (♩ = 80)" selected>Moderato (♩ = 80)</option>
                        <option value="Allegro (♩ = 120)">Allegro (♩ = 120)</option>
                        <option value="Andante (♩ = 60)">Andante (♩ = 60)</option>
                        <option value="Adagio (♩ = 48)">Adagio (♩ = 48)</option>
                        <option value="Presto (♩ = 140)">Presto (♩ = 140)</option>
                    </select>
                </div>

            </div>
        </div>

        <!-- Barra de Configurações de Pauta e Estrutura -->
        <div class="flex flex-wrap justify-center gap-3 mb-4 pdf-hide bg-gray-50 p-3 sm:p-4 rounded-xl border border-gray-200">
            <div class="flex flex-col items-center">
                <label class="text-xs font-semibold text-gray-500 uppercase mb-1">Clave / Instrumento</label>
                <select id="clef-select" onchange="changeClef()" class="border border-gray-300 rounded-lg px-2 py-1 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 font-medium text-indigo-900">
                    <option value="alto" selected>Clave de Dó 3ª lin (Viola)</option>
                    <option value="treble">Clave de Sol (Violino)</option>
                    <option value="bass">Clave de Fá (Violoncelo)</option>
                </select>
            </div>
            <div class="flex flex-col items-center">
                <label class="text-xs font-semibold text-gray-500 uppercase mb-1">Fórmula</label>
                <select id="time-select" onchange="renderStaff()" class="border border-gray-300 rounded-lg px-2 py-1 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="4/4" selected>4/4</option>
                    <option value="3/4">3/4</option>
                    <option value="2/4">2/4</option>
                    <option value="6/8">6/8</option>
                </select>
            </div>
            <div class="flex flex-col items-center">
                <label class="text-xs font-semibold text-gray-500 uppercase mb-1">Compassos/Linha</label>
                <select id="measures-select" onchange="renderStaff()" class="border border-gray-300 rounded-lg px-2 py-1 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="2">2 Comp.</option>
                    <option value="3">3 Comp.</option>
                    <option value="4" selected>4 Comp.</option>
                    <option value="5">5 Comp.</option>
                    <option value="6">6 Comp.</option>
                </select>
            </div>
        </div>

        <!-- Área da Partitura (Renderização VexFlow) -->
        <div class="w-full bg-white rounded-xl shadow-inner border border-gray-200 p-2 sm:p-4 mb-6 staff-container min-h-[200px]" id="vf-container">
            <!-- Partitura renderizada aqui -->
        </div>

        <!-- Painel de Ferramentas de Escrita -->
        <div class="pdf-hide space-y-3.5">
            
            <!-- Controle de Região / Oitava -->
            <div class="flex flex-wrap items-center justify-center gap-2 bg-indigo-50 p-2.5 rounded-xl border border-indigo-100">
                <span class="text-xs font-bold uppercase text-indigo-700 tracking-wide mr-1">Região / Oitava:</span>
                <button onclick="setOctave(2, this)" id="octave-2-btn" class="octave-btn px-3 py-1 bg-white hover:bg-indigo-100 text-indigo-900 border border-indigo-200 text-xs font-semibold rounded-lg shadow-sm transition-all">
                    Oitava 2 (C2)
                </button>
                <button onclick="setOctave(3, this)" id="octave-3-btn" class="octave-btn px-3 py-1 bg-white hover:bg-indigo-100 text-indigo-900 border border-indigo-200 text-xs font-semibold rounded-lg shadow-sm transition-all">
                    Oitava 3 (C3)
                </button>
                <button onclick="setOctave(4, this)" id="octave-4-btn" class="octave-btn px-3 py-1 bg-indigo-600 text-white border border-indigo-600 text-xs font-semibold rounded-lg shadow-sm transition-all">
                    Oitava 4 (C4)
                </button>
                <button onclick="setOctave(5, this)" id="octave-5-btn" class="octave-btn px-3 py-1 bg-white hover:bg-indigo-100 text-indigo-900 border border-indigo-200 text-xs font-semibold rounded-lg shadow-sm transition-all">
                    Oitava 5 (C5)
                </button>
                <button onclick="setOctave(6, this)" id="octave-6-btn" class="octave-btn px-3 py-1 bg-white hover:bg-indigo-100 text-indigo-900 border border-indigo-200 text-xs font-semibold rounded-lg shadow-sm transition-all">
                    Oitava 6 (C6)
                </button>
            </div>

            <!-- Durações -->
            <div class="flex flex-wrap justify-center gap-1.5 sm:gap-2">
                <button onclick="setDuration('w', this)" class="dur-btn bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium py-1 px-2.5 rounded-md text-xs sm:text-sm">Semibreve (4)</button>
                <button onclick="setDuration('h', this)" class="dur-btn bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium py-1 px-2.5 rounded-md text-xs sm:text-sm">Mínima (2)</button>
                <button onclick="setDuration('q', this)" class="dur-btn bg-indigo-500 hover:bg-indigo-600 text-white font-medium py-1 px-2.5 rounded-md text-xs sm:text-sm shadow-md">Semínima (1)</button>
                <button onclick="setDuration('8', this)" class="dur-btn bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium py-1 px-2.5 rounded-md text-xs sm:text-sm">Colcheia (1/2)</button>
                <button onclick="setDuration('16', this)" class="dur-btn bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium py-1 px-2.5 rounded-md text-xs sm:text-sm">Semicolcheia (1/4)</button>
                <button onclick="setDuration('32', this)" class="dur-btn bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium py-1 px-2.5 rounded-md text-xs sm:text-sm">Fusa</button>
                <button onclick="setDuration('64', this)" class="dur-btn bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium py-1 px-2.5 rounded-md text-xs sm:text-sm">Semifusa</button>
            </div>

            <!-- Modificadores Musicalmente Ricos -->
            <div class="flex flex-wrap justify-center gap-1.5 sm:gap-2">
                <!-- Acidentes -->
                <button id="sharp-btn" onclick="toggleAccidental('#')" class="text-xs sm:text-sm bg-red-50 hover:bg-red-100 text-red-800 font-medium py-1 px-2.5 rounded-full border border-red-200">Sustenido (#)</button>
                <button id="flat-btn" onclick="toggleAccidental('b')" class="text-xs sm:text-sm bg-red-50 hover:bg-red-100 text-red-800 font-medium py-1 px-2.5 rounded-full border border-red-200">Bemol (b)</button>
                <button id="natural-btn" onclick="toggleAccidental('n')" class="text-xs sm:text-sm bg-red-50 hover:bg-red-100 text-red-800 font-medium py-1 px-2.5 rounded-full border border-red-200">Bequadro (♮)</button>
                
                <!-- Arcos -->
                <button id="bow-talao-btn" onclick="toggleBow('talao')" class="text-xs sm:text-sm bg-blue-50 hover:bg-blue-100 text-blue-800 font-medium py-1 px-2.5 rounded-full border border-blue-200">Talão (⊓)</button>
                <button id="bow-ponta-btn" onclick="toggleBow('ponta')" class="text-xs sm:text-sm bg-blue-50 hover:bg-blue-100 text-blue-800 font-medium py-1 px-2.5 rounded-full border border-blue-200">Ponta (∨)</button>
                
                <!-- Articulações -->
                <button id="dot-btn" onclick="toggleDot()" class="text-xs sm:text-sm bg-yellow-50 hover:bg-yellow-100 text-yellow-800 font-medium py-1 px-2.5 rounded-full border border-yellow-200">Ponto (.)</button>
                <button id="staccato-btn" onclick="toggleStaccato()" class="text-xs sm:text-sm bg-pink-50 hover:bg-pink-100 text-pink-800 font-medium py-1 px-2.5 rounded-full border border-pink-200">Staccato</button>
                <button id="tie-btn" onclick="toggleTie()" class="text-xs sm:text-sm bg-teal-50 hover:bg-teal-100 text-teal-800 font-medium py-1 px-2.5 rounded-full border border-teal-200">Ligadura</button>
            </div>

            <!-- Dedilhados & Cordas do Instrumento -->
            <div class="flex flex-wrap justify-center items-center gap-1.5 sm:gap-2 bg-amber-50/70 p-2 rounded-xl border border-amber-200/60">
                <span class="text-xs font-bold uppercase text-amber-800 mr-1">Dedilhado / Corda:</span>
                <button id="fing-0" onclick="toggleFingering('0')" class="fing-btn text-xs bg-white hover:bg-amber-100 text-amber-900 border border-amber-300 font-bold px-2 py-0.5 rounded shadow-sm">0 (Solta)</button>
                <button id="fing-1" onclick="toggleFingering('1')" class="fing-btn text-xs bg-white hover:bg-amber-100 text-amber-900 border border-amber-300 font-bold px-2 py-0.5 rounded shadow-sm">1º Dedo</button>
                <button id="fing-2" onclick="toggleFingering('2')" class="fing-btn text-xs bg-white hover:bg-amber-100 text-amber-900 border border-amber-300 font-bold px-2 py-0.5 rounded shadow-sm">2º Dedo</button>
                <button id="fing-3" onclick="toggleFingering('3')" class="fing-btn text-xs bg-white hover:bg-amber-100 text-amber-900 border border-amber-300 font-bold px-2 py-0.5 rounded shadow-sm">3º Dedo</button>
                <button id="fing-4" onclick="toggleFingering('4')" class="fing-btn text-xs bg-white hover:bg-amber-100 text-amber-900 border border-amber-300 font-bold px-2 py-0.5 rounded shadow-sm">4º Dedo</button>

                <div class="h-4 w-[1px] bg-amber-300 mx-1"></div>

                <div id="string-buttons-container" class="flex items-center gap-1.5"></div>
            </div>

            <!-- Dinâmicas Musicais -->
            <div class="flex flex-wrap justify-center items-center gap-1.5 bg-purple-50 p-2 rounded-xl border border-purple-100">
                <span class="text-xs font-bold uppercase text-purple-800 mr-1">Dinâmica:</span>
                <button id="dyn-p" onclick="toggleDynamic('p')" class="dyn-btn text-xs italic font-serif bg-white hover:bg-purple-100 text-purple-900 border border-purple-200 px-2.5 py-0.5 rounded shadow-sm">p</button>
                <button id="dyn-mp" onclick="toggleDynamic('mp')" class="dyn-btn text-xs italic font-serif bg-white hover:bg-purple-100 text-purple-900 border border-purple-200 px-2.5 py-0.5 rounded shadow-sm">mp</button>
                <button id="dyn-mf" onclick="toggleDynamic('mf')" class="dyn-btn text-xs italic font-serif bg-white hover:bg-purple-100 text-purple-900 border border-purple-200 px-2.5 py-0.5 rounded shadow-sm">mf</button>
                <button id="dyn-f" onclick="toggleDynamic('f')" class="dyn-btn text-xs italic font-serif bg-white hover:bg-purple-100 text-purple-900 border border-purple-200 px-2.5 py-0.5 rounded shadow-sm">f</button>
                <button id="dyn-ff" onclick="toggleDynamic('ff')" class="dyn-btn text-xs italic font-serif bg-white hover:bg-purple-100 text-purple-900 border border-purple-200 px-2.5 py-0.5 rounded shadow-sm">ff</button>
            </div>

            <!-- Inserção de Notas e Estruturas -->
            <div class="flex flex-wrap justify-center gap-1.5 sm:gap-2">
                <button onclick="addNote('c')" class="note-btn min-w-[42px] h-10 bg-indigo-100 hover:bg-indigo-200 text-indigo-900 font-bold rounded-lg shadow-sm border border-indigo-200 text-xs sm:text-sm px-1.5" data-note="c">Dó4</button>
                <button onclick="addNote('d')" class="note-btn min-w-[42px] h-10 bg-indigo-100 hover:bg-indigo-200 text-indigo-900 font-bold rounded-lg shadow-sm border border-indigo-200 text-xs sm:text-sm px-1.5" data-note="d">Ré4</button>
                <button onclick="addNote('e')" class="note-btn min-w-[42px] h-10 bg-indigo-100 hover:bg-indigo-200 text-indigo-900 font-bold rounded-lg shadow-sm border border-indigo-200 text-xs sm:text-sm px-1.5" data-note="e">Mi4</button>
                <button onclick="addNote('f')" class="note-btn min-w-[42px] h-10 bg-indigo-100 hover:bg-indigo-200 text-indigo-900 font-bold rounded-lg shadow-sm border border-indigo-200 text-xs sm:text-sm px-1.5" data-note="f">Fá4</button>
                <button onclick="addNote('g')" class="note-btn min-w-[42px] h-10 bg-indigo-100 hover:bg-indigo-200 text-indigo-900 font-bold rounded-lg shadow-sm border border-indigo-200 text-xs sm:text-sm px-1.5" data-note="g">Sol4</button>
                <button onclick="addNote('a')" class="note-btn min-w-[42px] h-10 bg-indigo-100 hover:bg-indigo-200 text-indigo-900 font-bold rounded-lg shadow-sm border border-indigo-200 text-xs sm:text-sm px-1.5" data-note="a">Lá4</button>
                <button onclick="addNote('b')" class="note-btn min-w-[42px] h-10 bg-indigo-100 hover:bg-indigo-200 text-indigo-900 font-bold rounded-lg shadow-sm border border-indigo-200 text-xs sm:text-sm px-1.5" data-note="b">Si4</button>
                
                <button onclick="addRest()" class="px-3 h-10 bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold rounded-lg shadow-sm text-xs sm:text-sm">Pausa</button>
                
                <div class="h-10 w-[1px] bg-gray-300 mx-0.5"></div>

                <!-- Ritornelos e Voltas -->
                <button onclick="addRepeatStart()" class="px-2.5 h-10 bg-purple-100 hover:bg-purple-200 text-purple-900 font-bold rounded-lg shadow-sm border border-purple-200 text-xs sm:text-sm">|: Início</button>
                <button onclick="addRepeatEnd()" class="px-2.5 h-10 bg-purple-100 hover:bg-purple-200 text-purple-900 font-bold rounded-lg shadow-sm border border-purple-200 text-xs sm:text-sm">Fim :|</button>
                <button onclick="addVolta(1)" class="px-2.5 h-10 bg-indigo-100 hover:bg-indigo-200 text-indigo-900 font-bold rounded-lg shadow-sm border border-indigo-200 text-xs sm:text-sm">1ª Vez</button>
                <button onclick="addVolta(2)" class="px-2.5 h-10 bg-indigo-100 hover:bg-indigo-200 text-indigo-900 font-bold rounded-lg shadow-sm border border-indigo-200 text-xs sm:text-sm">2ª Vez</button>
            </div>

            <!-- Ações Gerais -->
            <div class="flex justify-center gap-3 pt-2">
                <button onclick="undo()" class="px-5 py-2 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-lg shadow-md transition-all text-sm">Desfazer</button>
                <button onclick="clearStaff()" class="px-5 py-2 bg-rose-600 hover:bg-rose-700 text-white font-bold rounded-lg shadow-md transition-all text-sm">Limpar Tudo</button>
            </div>
        </div>
    </div>

    <script>
        const VF = Vex.Flow;
        
        let notesArray = [];
        let currentClef = 'alto';
        let currentDuration = 'q';    
        let currentOctave = 4;
        
        let currentAccidental = null; 
        let currentBow = null;        
        let currentDot = false;
        let currentStaccato = false;
        let currentTie = false;
        let currentFingering = null;
        let currentStringInd = null;
        let currentDynamic = null;

        let isPlaying = false;
        let playbackTimeout = null;
        let audioCtx = null;
        let reverbNode = null;

        let metronomeInterval = null;
        let isMetronomeOn = false;
        let bpm = 80;

        const noteNamesPt = { 'c': 'Dó', 'd': 'Ré', 'e': 'Mi', 'f': 'Fá', 'g': 'Sol', 'a': 'Lá', 'b': 'Si' };
        const noteBaseMidi = { 'c': 0, 'd': 2, 'e': 4, 'f': 5, 'g': 7, 'a': 9, 'b': 11 };

        const instrumentStrings = {
            'alto': [
                { id: 'C', name: 'Corda Dó' },
                { id: 'G', name: 'Corda Sol' },
                { id: 'D', name: 'Corda Ré' },
                { id: 'A', name: 'Corda Lá' }
            ],
            'treble': [
                { id: 'G', name: 'Corda Sol' },
                { id: 'D', name: 'Corda Ré' },
                { id: 'A', name: 'Corda Lá' },
                { id: 'E', name: 'Corda Mi' }
            ],
            'bass': [
                { id: 'C', name: 'Corda Dó' },
                { id: 'G', name: 'Corda Sol' },
                { id: 'D', name: 'Corda Ré' },
                { id: 'A', name: 'Corda Lá' }
            ]
        };

        const durationBeats = { 
            'w': 4, 
            'h': 2, 
            'q': 1, 
            '8': 0.5, 
            '16': 0.25, 
            '32': 0.125, 
            '64': 0.0625 
        };

        function calculateExactFrequency(noteKey, octave, accidental) {
            let midi = (octave + 1) * 12 + noteBaseMidi[noteKey.toLowerCase()];
            if (accidental === '#') midi += 1;
            if (accidental === 'b') midi -= 1;
            return 440 * Math.pow(2, (midi - 69) / 12);
        }

        function getAudioContext() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                setupReverb();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
            return audioCtx;
        }

        function setupReverb() {
            const delay = audioCtx.createDelay();
            const feedback = audioCtx.createGain();
            const filter = audioCtx.createBiquadFilter();

            delay.delayTime.value = 0.075; 
            feedback.gain.value = 0.25;   
            filter.type = 'lowpass';
            filter.frequency.value = 2200;

            delay.connect(feedback);
            feedback.connect(filter);
            filter.connect(delay);
            filter.connect(audioCtx.destination);

            reverbNode = delay;
        }

        function playBowedStringNote(freq, durationSeconds, dynamicStr) {
            const ctx = getAudioContext();
            const now = ctx.currentTime;

            let baseGain = 0.25;
            if (dynamicStr === 'p') baseGain = 0.12;
            else if (dynamicStr === 'mp') baseGain = 0.18;
            else if (dynamicStr === 'mf') baseGain = 0.28;
            else if (dynamicStr === 'f') baseGain = 0.38;
            else if (dynamicStr === 'ff') baseGain = 0.48;

            const oscSaw = ctx.createOscillator();
            oscSaw.type = 'sawtooth';
            oscSaw.frequency.setValueAtTime(freq, now);

            const oscTri = ctx.createOscillator();
            oscTri.type = 'triangle';
            oscTri.frequency.setValueAtTime(freq, now);

            const lfo = ctx.createOscillator();
            const lfoGain = ctx.createGain();
            lfo.type = 'sine';
            lfo.frequency.setValueAtTime(5.5, now); 
            lfoGain.gain.setValueAtTime(0, now);
            lfoGain.gain.setTargetAtTime(freq * 0.008, now + 0.12, 0.08); 

            lfo.connect(oscSaw.frequency);
            lfo.connect(oscTri.frequency);

            const bodyFilter = ctx.createBiquadFilter();
            bodyFilter.type = 'lowpass';
            
            const startCutoff = Math.min(freq * 2.5, 1200);
            const peakCutoff = Math.min(freq * 6.5, 8000);
            bodyFilter.frequency.setValueAtTime(startCutoff, now);
            bodyFilter.frequency.exponentialRampToValueAtTime(peakCutoff, now + 0.08);
            bodyFilter.frequency.exponentialRampToValueAtTime(startCutoff * 1.5, now + durationSeconds);

            const masterGain = ctx.createGain();
            const attackTime = 0.07;
            const releaseTime = 0.15;

            masterGain.gain.setValueAtTime(0.0001, now);
            masterGain.gain.linearRampToValueAtTime(baseGain, now + attackTime);
            masterGain.gain.setValueAtTime(baseGain, now + durationSeconds - 0.02);
            masterGain.gain.exponentialRampToValueAtTime(0.0001, now + durationSeconds + releaseTime);

            oscSaw.connect(bodyFilter);
            oscTri.connect(bodyFilter);
            bodyFilter.connect(masterGain);

            masterGain.connect(ctx.destination);
            if (reverbNode) {
                masterGain.connect(reverbNode);
            }

            lfo.start(now);
            oscSaw.start(now);
            oscTri.start(now);

            const stopTime = now + durationSeconds + releaseTime + 0.05;
            lfo.stop(stopTime);
            oscSaw.stop(stopTime);
            oscTri.stop(stopTime);
        }

