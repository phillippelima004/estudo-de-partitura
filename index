        function startPlayback() {
            const executableNotes = notesArray.filter(n => n.type === 'note' || n.type === 'rest');
            if (executableNotes.length === 0) {
                showMessage("Escreva algumas notas antes de tocar!");
                return;
            }

            isPlaying = true;
            document.getElementById('play-icon').textContent = "❚❚";
            document.getElementById('play-text').textContent = "Pausar";
            document.getElementById('play-btn').className = "bg-amber-500 hover:bg-amber-400 text-white px-3.5 py-1.5 rounded-lg font-bold text-xs sm:text-sm flex items-center gap-1.5 transition-all shadow-sm";

            let noteIndex = 0;

            function playNextNote() {
                if (!isPlaying || noteIndex >= executableNotes.length) {
                    stopPlayback();
                    return;
                }

                const item = executableNotes[noteIndex];
                const beats = durationBeats[item.duration] * (item.dot ? 1.5 : 1);
                const durationSeconds = (beats * (60 / bpm));
                const durationMs = durationSeconds * 1000;

                if (item.type === 'note') {
                    const freq = calculateExactFrequency(item.key, item.octave, item.accidental);
                    playBowedStringNote(freq, durationSeconds, item.dynamic);
                }

                if (item.vfNoteObj && item.vfNoteObj.getSVGElement) {
                    const el = item.vfNoteObj.getSVGElement();
                    if (el) el.classList.add('playing-note');
                    setTimeout(() => {
                        if (el) el.classList.remove('playing-note');
                    }, durationMs);
                }

                noteIndex++;
                playbackTimeout = setTimeout(playNextNote, durationMs);
            }

            playNextNote();
        }

        function stopPlayback() {
            isPlaying = false;
            clearTimeout(playbackTimeout);
            document.getElementById('play-icon').textContent = "▶";
            document.getElementById('play-text').textContent = "Ouvir Partitura";
            document.getElementById('play-btn').className = "bg-indigo-500 hover:bg-indigo-400 text-white px-3.5 py-1.5 rounded-lg font-bold text-xs sm:text-sm flex items-center gap-1.5 transition-all shadow-sm";
